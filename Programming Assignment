]\nfor cls in classes:\n    folder=os.path.join(test_dir,cls)\n    for img_name in os.listdir(folder):\n        img_path=os.path.join(folder,img_name)\n        feat=compute_edge_histogram(img_path)\n        X_test.append(feat)\n        y_test.append(cls)\nX_train=np.array(X_train)\ny_train=np.array(y_train)\nX_test=np.array(X_test)\ny_test=np.array(y_test)\nprint(\"Training shape:\",X_train.shape)\nprint(\"Testing shape:\",X_test.shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-31T04:43:03.737713Z","iopub.execute_input":"2025-10-31T04:43:03.738101Z","iopub.status.idle":"2025-10-31T04:47:15.722596Z","shell.execute_reply.started":"2025-10-31T04:43:03.738071Z","shell.execute_reply":"2025-10-31T04:47:15.721332Z"}},"outputs":[{"name":"stdout","text":"Training shape: (5712, 36)\nTesting shape: (1311, 36)\n","output_type":"stream"}],"execution_count":4},{"cell_type":"markdown","source":"# Step 3: Dataset Split (0.25 point)\nThe dataset provides a pre-split structure with separate Training (5712 images) and Testing (1311 images) folders across the four classes: glioma, meningioma, notumor, and pituitary.\nThe ratio between training and testing samples for each class is approximately 80/20, which fully satisfies the assignment requirement. This ensures that each class now conforms closely to the required 80/20 ratio, satisfying the assignment’s explicit instruction.","metadata":{}},{"cell_type":"code","source":"train_indices,test_indices=[],[]\nX_all=np.concatenate([X_train, X_test], axis=0)\ny_all=np.concatenate([y_train, y_test], axis=0)\nX_train_adj,X_test_adj,y_train_adj,y_test_adj=[],[],[],[]\nfor cls in classes:\n    idx=np.where(y_all == cls)[0]\n    np.random.shuffle(idx)\n    total=len(idx)\n    train_count=floor(total * 0.8)\n    train_idx=idx[:train_count]\n    test_idx = idx[train_count:]\n    X_train_adj.append(X_all[train_idx])\n    y_train_adj.append(y_all[train_idx])\n    X_test_adj.append(X_all[test_idx])\n    y_test_adj.append(y_all[test_idx])\n    print(f\"{cls:<12}|total={total:<5}->train={len(train_idx):<5} test={len(test_idx):<5}\")\nX_train=np.vstack(X_train_adj)\nX_test=np.vstack(X_test_adj)\ny_train=np.concatenate(y_train_adj)\ny_test=np.concatenate(y_test_adj)\nprint(\"\\nAdjusted shapes:\")\nprint(\"X_train:\",X_train.shape,\"y_train:\",y_train.shape)\nprint(\"X_test :\",X_test.shape,\"y_test :\",y_test.shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-31T04:47:15.723916Z","iopub.execute_input":"2025-10-31T04:47:15.72423Z","iopub.status.idle":"2025-10-31T04:47:15.738064Z","shell.execute_reply.started":"2025-10-31T04:47:15.724194Z","shell.execute_reply":"2025-10-31T04:47:15.736603Z"}},"outputs":[{"name":"stdout","text":"glioma      |total=1621 →train=1296  test=325  \nmeningioma  |total=1645 →train=1316  test=329  \nnotumor     |total=2000 →train=1600  test=400  \npituitary   |total=1757 →train=1405  test=352  \n\nAdjusted shapes:\nX_train: (5617, 36) y_train: (5617,)\nX_test : (1406, 36) y_test : (1406,)\n","output_type":"stream"}],"execution_count":5},{"cell_type":"markdown","source":"## 4.Performstandardizationonthetrainingdataset. (seehttps://scikit-learn.org/stable/modules/preprocessing.html (0.25 point)\n ","metadata":{}},{"cell_type":"code","source":"scaler=StandardScaler()\nX_train_std=scaler.fit_transform(X_train)\nprint(\"Step 4: Standardization on training dataset completed.\\n\")\nprint(\"Shape:\",X_train_std.shape)\nprint(\"Feature-wise mean (≈0):\",np.mean(X_train_std, axis=0)[:5].round(4))\nprint(\"Feature-wise std  (≈1):\",np.std(X_train_std, axis=0)[:5].round(4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-31T04:47:15.739053Z","iopub.execute_input":"2025-10-31T04:47:15.739345Z","iopub.status.idle":"2025-10-31T04:47:15.781154Z","shell.execute_reply.started":"2025-10-31T04:47:15.739299Z","shell.execute_reply":"2025-10-31T04:47:15.780231Z"}},"outputs":[{"name":"stdout","text":"Step 4: Standardization on training data