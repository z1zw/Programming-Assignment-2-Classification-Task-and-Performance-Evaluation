e":"2025-10-31T05:40:23.695682","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Classes: ['glioma', 'meningioma', 'notumor', 'pituitary']\n"]}],"source":["train_dir=\"/kaggle/input/brain-tumor-mri-dataset/Training\"\n","test_dir=\"/kaggle/input/brain-tumor-mri-dataset/Testing\"\n","classes=sorted(os.listdir(train_dir))\n","print(\"Classes:\",classes)"]},{"cell_type":"markdown","id":"929002a0","metadata":{"papermill":{"duration":0.004497,"end_time":"2025-10-31T05:40:23.722521","exception":false,"start_time":"2025-10-31T05:40:23.718024","status":"completed"},"tags":[]},"source":[" ## Convert the images to edge histograms. (Assignment 1- These will be the vector representations of the images). This will be your dataset for Part 3. (0.25 point)"]},{"cell_type":"code","execution_count":3,"id":"59613f53","metadata":{"execution":{"iopub.execute_input":"2025-10-31T05:40:23.733199Z","iopub.status.busy":"2025-10-31T05:40:23.73285Z","iopub.status.idle":"2025-10-31T05:40:23.738591Z","shell.execute_reply":"2025-10-31T05:40:23.737744Z"},"papermill":{"duration":0.012688,"end_time":"2025-10-31T05:40:23.739868","exception":false,"start_time":"2025-10-31T05:40:23.72718","status":"completed"},"tags":[]},"outputs":[],"source":["def compute_edge_histogram(image_path, nbins=36, size=(128, 128)):\n","    image=cv2.imread(image_path)\n","    image=cv2.cvtColor(image,cv2.COLOR_BGR2RGB)\n","    gray=color.rgb2gray(image)\n","    dx=filters.sobel_h(gray)\n","    dy=filters.sobel_v(gray)\n","    angle=np.mod(np.arctan2(dy, dx),np.pi)\n","    hist,_=exposure.histogram(angle,nbins=nbins)\n","    hist=hist/np.sum(hist)\n","    return hist"]},{"cell_type":"code","execution_count":4,"id":"dd69ae9e","metadata":{"execution":{"iopub.execute_input":"2025-10-31T05:40:23.750999Z","iopub.status.busy":"2025-10-31T05:40:23.750665Z","iopub.status.idle":"2025-10-31T05:44:40.033393Z","shell.execute_reply":"2025-10-31T05:44:40.032359Z"},"papermill":{"duration":256.29