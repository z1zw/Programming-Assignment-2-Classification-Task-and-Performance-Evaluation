t shape:X_two={X_two.shape},y_two={y_two.shape}\")\n","C_values=[0.1,1,10,100]\n","results_standard,results_stratified=[],[]\n","train_errors_standard,val_errors_standard=[],[]\n","train_errors_stratified,val_errors_stratified=[],[]\n","for C in C_values:\n","    svc=LinearSVC(C=C,random_state=42,max_iter=20000,tol=1e-3,dual=False)\n","    kf=KFold(n_splits=5,shuffle=True,random_state=42)\n","    scores_kf=cross_val_score(svc,X_two,y_two,cv=kf,scoring='accuracy')\n","    results_standard.append({\n","        'C': C,'CV Type':'Standard 5-Fold',\n","        'Mean Accuracy':scores_kf.mean(),'Std': scores_kf.std()\n","    })\n","    train_acc,val_acc=[],[]\n","    for train_idx,val_idx in kf.split(X_two):\n","        X_tr,X_val=X_two[train_idx],X_two[val_idx]\n","        y_tr,y_val=y_two[train_idx],y_two[val_idx]\n","        svc.fit(X_tr,y_tr)\n","        train_acc.append(svc.score(X_tr,y_tr))\n","        val_acc.append(svc.score(X_val,y_val))\n","    train_errors_standard.append(100*(1-np.mean(train_acc)))\n","    val_errors_standard.append(100*(1-np.mean(val_acc)))\n","    skf=StratifiedKFold(n_splits=5,shuffle=True,random_state=42)\n","    scores_skf=cross_val_score(svc,X_two,y_two,cv=skf,scoring='accuracy')\n","    results_stratified.append({\n","        'C': C,'CV Type':'Stratified 5-Fold',\n","        'Mean Accuracy':scores_skf.mean(),'Std':scores_skf.std()\n","    })\n","\n","    train_acc,val_acc=[],[]\n","    for train_idx,val_idx in skf.split(X_two,y_two):\n","        X_tr,X_val=X_two[train_idx],X_two[val_idx]\n","        y_tr,y_val=y_two[train_idx],y_two[val_idx]\n","        svc.fit(X_tr,y_tr)\n","        train_acc.append(svc.score(X_tr,y_tr))\n","        val_acc.append(svc.score(X_val,y_val))\n","    train_errors_stratified.append(100*(1-np.mean(train_acc)))\n","    val_errors_stratified.append(100*(1-np.mean(val_acc)))\n","cv_results=pd.DataFrame(results_standard+results_stratified)\n","print(\"\\nLinearSVC Model Selection Results (Two Classes):\\n\")\n","p